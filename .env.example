# Resend API key (https://resend.com/api-keys). Without it the contact
# endpoint answers 502 and the form shows the email fallback.
RESEND_API_KEY=

# Optional. Defaults shown. While no domain is verified in Resend, the
# sender must stay onboarding@resend.dev and CONTACT_TO must be the
# Resend account's own address.
# CONTACT_TO=tobias.rosa2000@gmail.com
# CONTACT_FROM=Portfolio <onboarding@resend.dev>
