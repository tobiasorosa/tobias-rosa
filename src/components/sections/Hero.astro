---
import Button from '../ui/Button.astro';
import GhostLink from '../ui/GhostLink.astro';
import SlideUpText from '../ui/SlideUpText.astro';
import StatusDot from '../ui/StatusDot.astro';
import TextLink from '../ui/TextLink.astro';
import ProfilePanel from './ProfilePanel.astro';
import { site } from '../../data/site';
---

<header
  id="top"
  class="mx-auto max-w-page px-gutter pt-[clamp(56px,8vw,120px)] pb-[clamp(56px,7vw,96px)]"
>
  <div
    class="grid grid-cols-1 items-start gap-[clamp(40px,5vw,80px)]
           wide:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
  >
    <div class="min-w-0">
      <p class="label-mono mb-8 flex animate-enter flex-wrap items-center gap-2 text-stone">
        <StatusDot />
        <span>{site.role}</span>
        <span class="text-graphite" aria-hidden="true">/</span>
        <span>{site.location}</span>
      </p>

      <!-- The cursor sits outside the animated text so it never slides. -->
      <h1 class="mb-8 text-display text-balance text-bone">
        <SlideUpText>I build SaaS platforms that hold up.</SlideUpText><span
          aria-hidden="true"
          class="ml-[0.16em] inline-block h-[0.68em] w-[0.34em] animate-blink bg-orange"></span>
      </h1>

      <p class="mb-4 max-w-[58ch] animate-enter text-pretty text-stone" style="--enter-delay:350ms">
        Five years of C#, .NET, React and TypeScript — mostly backend services and the frontends that
        live on top of them. Right now I do that for US product teams at {site.employer.name}, and on
        the side I co-founded <TextLink
          href={site.sideProject.url}
          target="_blank"
          rel="noopener"
          class="text-bone">{site.sideProject.name}</TextLink
        >, a scheduling app shipping on both stores.
      </p>
      <p class="mb-10 max-w-[58ch] animate-enter text-pretty text-granite" style="--enter-delay:410ms">
        I like the unglamorous parts: clean architecture that survives the second year, queries that
        stop being slow, production bugs that turn out to be three services deep.
      </p>

      <div class="flex animate-enter flex-wrap gap-4" style="--enter-delay:470ms">
        <Button href="#work" variant="dark">See the work</Button>
        <GhostLink href={site.resume} download>
          Download résumé <span aria-hidden="true">↓</span>
        </GhostLink>
      </div>
    </div>

    <ProfilePanel />
  </div>
</header>
