---
import Button from '../ui/Button.astro';
import Field from '../ui/Field.astro';
import GhostLink from '../ui/GhostLink.astro';
import Input from '../ui/Input.astro';
import LightCard from '../ui/LightCard.astro';
import MonoLabel from '../ui/MonoLabel.astro';
import StatusDot from '../ui/StatusDot.astro';
import Textarea from '../ui/Textarea.astro';
import TextLink from '../ui/TextLink.astro';
import { site } from '../../data/site';

type ContactRow = { term: string; links: { label: string; href: string }[] };

const rows: ContactRow[] = [
  { term: 'Email', links: [{ label: site.email, href: `mailto:${site.email}` }] },
  { term: 'WhatsApp', links: [site.whatsapp] },
  { term: 'Elsewhere', links: site.socials.map((s) => ({ label: s.short, href: s.href })) },
];
---

<section id="contact" aria-labelledby="contact-title" class="mx-auto max-w-page px-gutter pt-24">
  <LightCard>
    <div
      class="grid grid-cols-1 items-start gap-[clamp(40px,5vw,80px)]
             wide:grid-cols-[minmax(0,1.3fr)_minmax(0,0.8fr)]"
    >
      <div class="min-w-0">
        <MonoLabel class="flex items-center gap-2"><StatusDot />04 — Contact</MonoLabel>
        <h2 id="contact-title" class="mt-6 mb-4 text-heading">Tell me what you're building.</h2>
        <p class="mb-10 max-w-[56ch] text-pretty text-graphite">
          If you're hiring for a full stack or backend role, or you need someone to take a .NET and
          React product further than it is now, write to me. I read everything and answer in English
          or Portuguese.
        </p>

        <!-- The native action is the no-JS fallback; the script upgrades it
             to a pre-composed mailto: with a readable body. -->
        <form
          data-contact
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
          class="grid max-w-[620px] gap-6"
        >
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(220px,100%),1fr))] gap-6">
            <Field label="Name" for="c-name">
              <Input id="c-name" name="name" type="text" placeholder="Your name" required />
            </Field>
            <Field label="Email" for="c-email">
              <Input id="c-email" name="email" type="email" placeholder="you@company.com" required />
            </Field>
          </div>
          <Field label="Message" for="c-msg">
            <Textarea
              id="c-msg"
              name="message"
              rows="5"
              placeholder="The role, the product, the problem."
              required
            />
          </Field>
          <div class="flex flex-wrap items-center gap-6">
            <Button type="submit" variant="ink">Send message</Button>
            <MonoLabel data-contact-note class="text-graphite">Opens your mail app.</MonoLabel>
          </div>
        </form>
      </div>

      <dl class="min-w-0 border-t border-stone">
        {
          rows.map((r) => (
            <div class="flex flex-col gap-3 border-b border-stone py-5">
              <dt class="label-mono text-graphite">{r.term}</dt>
              <dd class={r.links.length > 1 ? 'flex flex-col items-start gap-2' : undefined}>
                {r.links.map((l) => (
                  <TextLink
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener' : undefined}
                  >
                    {l.label}
                  </TextLink>
                ))}
              </dd>
            </div>
          ))
        }
        <div class="flex flex-col items-start gap-4 pt-5">
          <dt class="label-mono text-graphite">Résumé</dt>
          <dd>
            <GhostLink variant="ink" href={site.resume} download>
              Download PDF <span aria-hidden="true">↓</span>
            </GhostLink>
          </dd>
        </div>
      </dl>
    </div>
  </LightCard>
</section>
