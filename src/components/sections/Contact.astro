---
import Button from '../ds/Button.astro';
import Card from '../ds/Card.astro';
import Field from '../ds/Field.astro';
import Input from '../ds/Input.astro';
import Textarea from '../ds/Textarea.astro';
import { site } from '../../data/site';
---

<section id="contact" aria-labelledby="contact-title" class="mt-24 border-t border-subtle bg-deep">
  <div
    class="mx-auto grid max-w-content grid-cols-1 gap-10 px-gutter py-24
           wide:grid-cols-[1.4fr_0.8fr] wide:items-start wide:gap-[clamp(32px,5vw,72px)]"
  >
    <div data-reveal class="min-w-0">
      <span
        class="inline-flex items-center gap-3 font-mono text-micro tracking-eyebrow uppercase text-accent
               before:content-[''] before:w-7 before:border-t-2 before:border-accent"
      >
        04 — Contact
      </span>
      <h2 id="contact-title" class="mt-3 mb-4 text-h2 font-semibold leading-snug tracking-heading text-ink-strong">
        Tell me what you're building.
      </h2>
      <p class="mb-8 max-w-[60ch] text-ink-muted">
        If you're hiring for a full stack or backend role, or you need someone to take a .NET and
        React product further than it is now, write to me. I read everything and answer in English or
        Portuguese.
      </p>

      <!-- The native action is the no-JS fallback; the script upgrades it
           to a pre-composed mailto: with a readable body. -->
      <form
        data-contact
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
        class="grid max-w-[620px] gap-5"
      >
        <div class="grid grid-cols-1 gap-5 wide:grid-cols-2">
          <Field label="Name" for="c-name">
            <Input id="c-name" name="name" type="text" placeholder="Your name" required />
          </Field>
          <Field label="Email" for="c-email">
            <Input id="c-email" name="email" type="email" placeholder="you@company.com" required />
          </Field>
        </div>
        <Field label="Message" for="c-msg">
          <Textarea
            id="c-msg"
            name="message"
            rows="5"
            placeholder="The role, the product, the problem."
            required
          />
        </Field>
        <div class="flex flex-wrap items-center gap-5">
          <Button type="submit" variant="primary" size="md">Send message</Button>
          <span data-contact-note class="font-mono text-caption text-ink-faint">
            Opens your mail app.
          </span>
        </div>
      </form>
    </div>

    <aside data-reveal data-reveal-delay="90" class="min-w-0">
      <Card padding="md">
        <dl>
          <div class="border-b border-subtle pb-3.5">
            <dt class="font-mono text-micro tracking-eyebrow text-ink-faint">EMAIL</dt>
            <dd class="mt-1.5 ml-0"><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div class="border-b border-subtle py-3.5">
            <dt class="font-mono text-micro tracking-eyebrow text-ink-faint">WHATSAPP</dt>
            <dd class="mt-1.5 ml-0">
              <a href={site.whatsapp.href} target="_blank" rel="noopener">{site.whatsapp.label}</a>
            </dd>
          </div>
          <div class="border-b border-subtle py-3.5">
            <dt class="font-mono text-micro tracking-eyebrow text-ink-faint">ELSEWHERE</dt>
            <dd class="mt-2 ml-0 flex flex-col gap-1.5">
              {
                site.socials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener">
                    {s.short}
                  </a>
                ))
              }
            </dd>
          </div>
          <div class="pt-3.5">
            <dt class="font-mono text-micro tracking-eyebrow text-ink-faint">RÉSUMÉ</dt>
            <dd class="mt-2.5 ml-0">
              <Button href={site.resume} download variant="ghost" size="sm">Download PDF</Button>
            </dd>
          </div>
        </dl>
      </Card>
    </aside>
  </div>

  <div class="border-t border-subtle">
    <div
      class="mx-auto flex max-w-content flex-wrap justify-between gap-4 px-gutter py-7
             font-mono text-micro tracking-label text-ink-faint"
    >
      <span>{site.name.toUpperCase()} · {site.role.toUpperCase()}</span>
      <span>BUILT WITH .NET HABITS AND TOO MUCH COFFEE · {new Date().getFullYear()}</span>
    </div>
  </div>
</section>
