---
import Button from '../ui/Button.astro';
import MonoLabel from '../ui/MonoLabel.astro';
import { site } from '../../data/site';
---

<nav class="sticky top-0 z-40 border-b border-lift bg-canvas" aria-label="Primary">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-8 px-gutter">
    <a href="#top" class="flex items-center gap-3">
      <MonoLabel class="text-bone">{site.name}</MonoLabel>
      <MonoLabel class="text-granite normal-case">~/portfolio</MonoLabel>
    </a>

    <div class="hidden items-center gap-8 wide:flex">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="text-sm leading-none text-stone uppercase hover:text-chalk aria-[current=true]:text-chalk"
          >
            {item.label}
          </a>
        ))
      }
      <Button href="#contact" variant="light" size="sm">Get in touch</Button>
    </div>
  </div>
</nav>
