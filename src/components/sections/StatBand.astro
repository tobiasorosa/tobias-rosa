---
import Stat from '../ds/Stat.astro';
import { stats } from '../../data/stats';
---

<section
  data-stats
  aria-label="By the numbers"
  class="border-y border-subtle bg-sunken"
>
  <div class="mx-auto grid max-w-content grid-cols-2 gap-8 px-gutter py-10 wide:grid-cols-4">
    {stats.map((s) => <Stat value={s.value} suffix={s.suffix} label={s.label} />)}
  </div>
</section>
