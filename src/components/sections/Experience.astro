---
import Tag from '../ds/Tag.astro';
import SectionHeading from '../ds/SectionHeading.astro';
import { experience } from '../../data/experience';

const row = 'grid grid-cols-1 gap-1 wide:grid-cols-[150px_1fr_220px] wide:gap-6';
---

<section id="experience" aria-labelledby="experience-title" class="mx-auto max-w-content px-gutter pt-24">
  <SectionHeading
    eyebrow="02 — Experience"
    title="Where I've worked"
    sub="Open a row for what the job actually involved."
    id="experience-title"
    data-reveal
  />

  <div class="mt-10 border-t border-line">
    <div
      class={`${row} border-b border-subtle pt-3.5 pb-3 font-mono text-micro font-semibold tracking-eyebrow text-ink-faint`}
      aria-hidden="true"
    >
      <span>DATES</span><span>ROLE</span><span>COMPANY</span>
    </div>

    {
      experience.map((r, i) => (
        <details
          data-role
          data-reveal
          data-reveal-delay={i * 30}
          open={i === 0}
          class="border-b border-subtle"
        >
          <summary class={`${row} cursor-pointer list-none items-baseline py-5`}>
            <span class={`font-mono text-caption ${r.current ? 'text-accent' : 'text-ink-faint'}`}>
              <time datetime={r.start}>{r.period}</time>
            </span>
            <span class="text-h4 font-semibold tracking-heading text-ink-strong">{r.title}</span>
            <span class="font-mono text-caption uppercase text-ink-muted">
              {r.company}{r.place && ` · ${r.place}`}
            </span>
          </summary>
          <div class="pb-6">
            <ul class="m-0 grid max-w-[1000px] list-none grid-cols-1 gap-3 p-0 wide:grid-cols-2 wide:gap-x-8">
              {r.bullets.map((b) => (
                <li class="flex gap-2.5 text-ink-muted">
                  <span class="text-brand-3" aria-hidden="true">
                    —
                  </span>
                  {b}
                </li>
              ))}
            </ul>
            {r.stack && (
              <ul class="mt-[18px] flex list-none flex-wrap gap-2 p-0">
                {r.stack.map((s) => (
                  <li>
                    <Tag>{s}</Tag>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>
