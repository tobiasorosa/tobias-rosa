---
import MonoLabel from '../ui/MonoLabel.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StatusDot from '../ui/StatusDot.astro';
import TagList from '../ui/TagList.astro';
import { cn } from '../../lib/cn';
import { experience } from '../../data/experience';

// Dates / role / company / toggle. Below 901px the cells stack.
const cols = 'wide:grid-cols-[140px_minmax(0,1fr)_220px_16px] wide:gap-6';
---

<section id="experience" aria-labelledby="experience-title" class="mx-auto max-w-page px-gutter pt-24">
  <SectionHeader
    eyebrow="02 — Experience"
    title="Where I've worked"
    sub="Open a row for what the job actually involved."
    id="experience-title"
  />

  <div class="border-t border-stroke">
    <div
      aria-hidden="true"
      class={`label-mono hidden border-b border-stroke py-4 text-granite wide:grid ${cols}`}
    >
      <span>Dates</span><span>Role</span><span>Company</span><span></span>
    </div>

    {
      experience.map((r, i) => (
        <details open={i === 0} class="group border-b border-stroke">
          <summary class={`group/row grid cursor-pointer grid-cols-1 items-center gap-2 py-6 ${cols}`}>
            <MonoLabel class={cn('flex items-center gap-2', r.current ? 'text-bone' : 'text-granite')}>
              {r.current && <StatusDot />}
              <time datetime={r.start}>{r.period}</time>
            </MonoLabel>
            <span class="text-base font-medium text-bone transition-colors group-hover/row:text-chalk">
              {r.title}
            </span>
            <MonoLabel class="text-stone">
              {r.company}
              {r.place && ` · ${r.place}`}
            </MonoLabel>
            <MonoLabel
              aria-hidden="true"
              class="hidden text-right text-stone after:content-['+'] group-open:after:content-['−'] wide:block"
            />
          </summary>
          <div class="pb-8 wide:pl-[164px]">
            <ul class="grid max-w-[920px] grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-x-10 gap-y-4">
              {r.bullets.map((b) => (
                <li class="flex gap-3 text-stone">
                  <span class="text-graphite" aria-hidden="true">
                    —
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            {r.stack && <TagList items={r.stack} class="mt-6" />}
          </div>
        </details>
      ))
    }
  </div>
</section>
