---
import { Image } from 'astro:assets';
import LightCard from '../ui/LightCard.astro';
import MonoLabel from '../ui/MonoLabel.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StatusDot from '../ui/StatusDot.astro';
import TagList from '../ui/TagList.astro';
import TextLink from '../ui/TextLink.astro';
import { projects } from '../../data/projects';

// Three phone-screen slots (1206:2622), each dropped a little further than the last.
const slotOffsets = ['', 'mt-8', 'mt-16'];
const row = 'grid grid-cols-1 gap-2 wide:grid-cols-[96px_minmax(0,1fr)] wide:gap-6';
---

<section
  id="work"
  aria-labelledby="work-title"
  class="mx-auto max-w-page px-gutter pt-[clamp(40px,6vw,96px)]"
>
  <SectionHeader
    eyebrow="01 — Selected work"
    title="Things I built and shipped"
    sub="One record for now — the product I care most about."
    id="work-title"
  />

  {
    projects.map((p) => (
      <LightCard as="article">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
          <MonoLabel class="flex items-center gap-2">
            <StatusDot />
            {p.platforms}
          </MonoLabel>
          <TextLink
            href={p.url}
            target="_blank"
            rel="noopener"
            class="label-mono inline-flex items-center gap-1.5 pb-1.5 normal-case"
          >
            {p.urlLabel} <span aria-hidden="true">↗</span>
          </TextLink>
        </div>

        <div
          class="grid grid-cols-1 items-start gap-[clamp(32px,4vw,56px)]
                 wide:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]"
        >
          <div class="min-w-0">
            <h3 class="mb-6 text-[length:clamp(44px,6vw,72px)] leading-none tracking-[-0.04em]">
              {p.name}
            </h3>
            <p class="mb-8 max-w-[56ch] text-pretty">{p.summary}</p>

            <dl class="border-t border-stone">
              {[
                ['Problem', p.problem],
                ['Built', p.built],
                ['My part', p.myPart],
              ].map(([term, detail]) => (
                <div class={`${row} border-b border-stone py-4`}>
                  <dt class="label-mono pt-[5px] text-graphite">{term}</dt>
                  <dd class="text-sm">{detail}</dd>
                </div>
              ))}
              <div class={`${row} pt-4`}>
                <dt class="label-mono pt-[7px] text-graphite">Stack</dt>
                <dd>
                  <TagList items={p.stack} />
                </dd>
              </div>
            </dl>
          </div>

          <div class="grid min-w-0 grid-cols-3 gap-4">
            {slotOffsets.map((offset, i) => {
              const shot = p.shots[i];
              return (
                <div
                  aria-hidden={shot ? undefined : 'true'}
                  class={`relative aspect-[201/437] overflow-hidden rounded-panel ${
                    shot ? 'border border-stone' : 'bg-canvas'
                  } ${offset}`}
                >
                  {shot && (
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={[180, 270, 360, 480, 720]}
                      sizes="(min-width: 901px) 150px, calc((100vw - 120px) / 3)"
                      loading="lazy"
                      class="size-full object-cover"
                    />
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </LightCard>
    ))
  }

  <MonoLabel as="p" class="mt-6 leading-normal text-granite">
    More records coming — client work under NDA for now.
  </MonoLabel>
</section>
