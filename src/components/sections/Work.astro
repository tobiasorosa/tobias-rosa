---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Card from '../ds/Card.astro';
import Badge from '../ds/Badge.astro';
import Tag from '../ds/Tag.astro';
import SectionHeading from '../ds/SectionHeading.astro';
import { projects } from '../../data/projects';
---

<section id="work" aria-labelledby="work-title" class="mx-auto max-w-content px-gutter pt-24">
  <SectionHeading
    eyebrow="01 — Selected work"
    title="Things I built and shipped"
    sub="One record for now — the product I care most about."
    id="work-title"
    data-reveal
  />

  {
    projects.map((p) => (
      <Card as="article" padding="lg" class="mt-10" data-reveal data-reveal-delay="90">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <div class="flex flex-wrap items-baseline gap-3.5">
            <h3 class="text-h3 font-semibold tracking-heading text-ink-strong">{p.name}</h3>
            <Badge variant="outline">{p.platforms}</Badge>
          </div>
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 font-mono text-caption tracking-label"
          >
            {p.urlLabel}
            <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
          </a>
        </div>

        <p class="my-[18px] mb-7 max-w-prose text-lead text-ink">{p.summary}</p>

        {p.shots.length > 0 && (
          <ul class="mb-7 grid list-none grid-cols-1 gap-4 p-0 wide:grid-cols-3">
            {p.shots.map((shot) => (
              <li class="overflow-hidden rounded-card border border-subtle bg-inset">
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  width={540}
                  height={960}
                  loading="lazy"
                  class="aspect-[9/16] w-full object-cover saturate-85"
                />
              </li>
            ))}
          </ul>
        )}

        <dl class="flex flex-col border-t border-subtle">
          {[
            ['PROBLEM', p.problem],
            ['BUILT', p.built],
            ['MY PART', p.myPart],
          ].map(([term, detail]) => (
            <div class="grid grid-cols-1 gap-1 border-b border-subtle py-4 wide:grid-cols-[120px_1fr] wide:gap-6">
              <dt class="font-mono text-micro font-semibold tracking-eyebrow text-ink-faint">
                {term}
              </dt>
              <dd class="m-0 max-w-prose text-ink">{detail}</dd>
            </div>
          ))}
          <div class="grid grid-cols-1 gap-1 py-4 wide:grid-cols-[120px_1fr] wide:gap-6">
            <dt class="font-mono text-micro font-semibold tracking-eyebrow text-ink-faint">STACK</dt>
            <dd class="m-0">
              <ul class="flex list-none flex-wrap gap-2 p-0">
                {p.stack.map((s) => (
                  <li>
                    <Tag>{s}</Tag>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </Card>
    ))
  }

  <p data-reveal data-reveal-delay="140" class="mt-6 font-mono text-caption text-ink-faint">
    MORE RECORDS COMING — CLIENT WORK UNDER NDA FOR NOW.
  </p>
</section>
