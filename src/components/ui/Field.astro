---
/** Field — a mono label above its control. Lives on light cards. */
import { cn } from '../../lib/cn';

type Props = { label: string; for: string; class?: string };
const { label, for: htmlFor, class: className } = Astro.props;
---

<div class={cn('flex min-w-0 flex-col gap-2', className)}>
  <label for={htmlFor} class="label-mono text-graphite">{label}</label>
  <slot />
</div>
