---
/** Tag — carries a technology name. */
import { cn } from '../../lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'span'>, 'class'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<span
  class={cn(
    'label-mono inline-flex h-7 items-center rounded-control border border-stroke px-2 text-stone',
    'on-light:border-stone on-light:text-canvas',
    className,
  )}
  {...rest}
>
  <slot />
</span>
