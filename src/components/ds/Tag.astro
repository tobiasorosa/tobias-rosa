---
/** Tag — ports `.ds-tag`. Mono type; carries technology names. */
import { cn } from '../../lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'span'>, 'class'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center gap-2 h-7 px-3 rounded-control bg-inset border border-subtle',
    'text-ink-muted font-mono text-micro tracking-[0.02em]',
    className,
  )}
  {...rest}
>
  <slot />
</span>
