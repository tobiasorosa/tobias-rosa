---
/** Field — ports `.ds-field`. Label + control + hint/error. */
import { cn } from '../../lib/cn';

type Props = { label: string; for: string; hint?: string; error?: string; class?: string };
const { label, for: htmlFor, hint, error, class: className } = Astro.props;
---

<div class={cn('flex flex-col gap-2', className)}>
  <label for={htmlFor} class="text-caption tracking-label uppercase text-ink-faint">{label}</label>
  <slot />
  {hint && !error && <p class="text-caption text-ink-faint">{hint}</p>}
  {error && <p class="text-caption text-danger">{error}</p>}
</div>
