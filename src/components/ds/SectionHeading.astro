---
/**
 * SectionHeading — ports `.ds-section-head`. The numbered eyebrow
 * ("01 — Selected work") threads the page; the rule before it is one
 * of only two places the DS allows a 2px border.
 */
import { cn } from '../../lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
  eyebrow: string;
  title: string;
  sub?: string;
  id?: string;
  class?: string;
};

const { eyebrow, title, sub, id, class: className, ...rest } = Astro.props;
---

<div class={cn('flex flex-col gap-3', className)} {...rest}>
  <span
    class="inline-flex items-center gap-3 font-mono text-micro tracking-eyebrow uppercase text-accent
           before:content-[''] before:w-7 before:border-t-2 before:border-accent"
  >
    {eyebrow}
  </span>
  <h2 id={id} class="text-h2 leading-snug">{title}</h2>
  {sub && <p class="text-lead text-ink-muted max-w-prose">{sub}</p>}
</div>
