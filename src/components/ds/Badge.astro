---
/** Badge — ports `.ds-badge`. `dot` renders the leading status pip. */
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';
import type { HTMLAttributes } from 'astro/types';

const badge = cva(
  'inline-flex items-center gap-1 h-[22px] px-2 rounded-chip border border-transparent ' +
    'text-micro font-semibold tracking-label uppercase',
  {
    variants: {
      variant: {
        neutral: 'bg-raised text-ink-muted',
        accent: 'bg-accent text-on-accent',
        outline: 'border-brand-3 text-accent',
        success: 'bg-success text-olive-950',
        warning: 'bg-warning text-olive-950',
        danger: 'bg-danger text-olive-950',
      },
    },
    defaultVariants: { variant: 'neutral' },
  },
);

type Props = VariantProps<typeof badge> &
  Omit<HTMLAttributes<'span'>, 'class'> & { dot?: boolean; class?: string };

const { variant, dot = false, class: className, ...rest } = Astro.props;
---

<span class={cn(badge({ variant }), className)} {...rest}>
  {dot && <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>}
  <slot />
</span>
