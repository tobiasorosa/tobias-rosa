---
/**
 * Stat — ports `.ds-stat`. The value renders at its final number so
 * the figure is present for crawlers and with JS off; the count-up
 * script only animates from 0 when the band scrolls into view.
 */
type Props = { value: number; suffix?: string; label: string };
const { value, suffix = '', label } = Astro.props;
---

<div class="flex flex-col gap-1">
  <span
    class="text-h2 font-bold leading-tight text-accent tabular-nums"
    data-count={value}
    data-suffix={suffix}>{value}{suffix}</span
  >
  <span class="text-caption tracking-label uppercase text-ink-faint">{label}</span>
</div>
