---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { site } from '../data/site';

type Props = { title?: string; description?: string; noindex?: boolean };
const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={site.lang} class="bg-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#333329" />
    <meta name="generator" content={Astro.generator} />

    <!-- LCP is the hero <h1>, so the display face is preloaded ahead of
         everything else. 20.7 KB, latin subset, variable 400–700. -->
    <link
      rel="preload"
      href="/fonts/afacad-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Seo {title} {description} {noindex} />
    <JsonLd />
  </head>
  <body class="bg-page text-ink font-core text-body leading-body antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50
             focus:rounded-control focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent
             focus:font-semibold"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
