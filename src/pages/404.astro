---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import GhostLink from '../components/ui/GhostLink.astro';
import MonoLabel from '../components/ui/MonoLabel.astro';
import StatusDot from '../components/ui/StatusDot.astro';
import { site } from '../data/site';
---

<Base title={`Page not found — ${site.name}`} noindex>
  <main id="main" class="mx-auto flex min-h-screen max-w-page flex-col justify-center px-gutter py-24">
    <MonoLabel class="flex items-center gap-2 text-stone"><StatusDot />404</MonoLabel>
    <h1 class="mt-8 text-display text-bone">Nothing here.</h1>
    <p class="mt-8 max-w-[58ch] text-stone">That address doesn't match anything on the site.</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/" variant="dark">Back to the start</Button>
      <GhostLink href={`mailto:${site.email}`}>Email me</GhostLink>
    </div>
  </main>
</Base>
