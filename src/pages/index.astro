---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import StatBand from '../components/sections/StatBand.astro';
import Work from '../components/sections/Work.astro';
import Experience from '../components/sections/Experience.astro';
import Toolkit from '../components/sections/Toolkit.astro';
import Contact from '../components/sections/Contact.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <StatBand />
    <Work />
    <Experience />
    <Toolkit />
    <Contact />
  </main>
</Base>

<script>
  /**
   * The page's only JavaScript. Everything below is progressive
   * enhancement: every element already renders in its final, visible
   * state, so a frozen, JS-less or reduced-motion document shows the
   * finished design.
   */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(.16,1,.3,1)';

  let animated = false;
  function animate() {
    if (animated || reduce) return;
    // A background tab never paints, so defer to the visibilitychange
    // retry below rather than burning the entrance while nobody looks.
    if (document.hidden) return;
    animated = true;

    // Next frame, so the document timeline is guaranteed to be running
    // before any animation is attached.
    requestAnimationFrame(() => {
      const apply = (sel: string, name: string, dur: string, delayKey: string) => {
        document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
          const delay = el.dataset[delayKey] ?? '0';
          el.style.animation = `${name} ${dur} ${EASE} ${delay}ms both`;
        });
      };

      apply('[data-anim="rise"]', 'tr-rise', '.62s', 'animDelay');
      apply('[data-anim="fade"]', 'tr-fade', '.5s', 'animDelay');
      apply('[data-reveal]', 'tr-fade', '.5s', 'revealDelay');
    });
  }

  animate();
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) animate();
  });

  // The hero caret blinks only once motion is allowed.
  if (!reduce) {
    document
      .querySelectorAll<HTMLElement>('[data-caret]')
      .forEach((el) => (el.style.animation = 'tr-blink 1.1s steps(1,end) 1s infinite'));
  }

  // Stat count-up — fires once, when the band is a third on screen.
  const band = document.querySelector('[data-stats]');
  if (band && !reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.disconnect();
          band.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
            const target = Number(el.dataset.count);
            const suffix = el.dataset.suffix ?? '';
            if (!Number.isFinite(target)) return;
            const t0 = performance.now();
            const step = (now: number) => {
              const p = Math.min(1, (now - t0) / 900);
              el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + suffix;
              if (p < 1) requestAnimationFrame(step);
            };
            el.textContent = '0' + suffix;
            requestAnimationFrame(step);
          });
        }
      },
      { threshold: 0.35 },
    );
    io.observe(band);
  }

  // Nav scroll-spy.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter((s): s is Element => Boolean(s));

  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const a of links) {
            const active = a.getAttribute('href') === `#${e.target.id}`;
            if (active) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }

  // Contact form: compose a readable mailto: instead of the raw
  // enctype="text/plain" body the native form action would send.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const name = String(d.get('name') ?? '').trim();
    const email = String(d.get('email') ?? '').trim();
    const msg = String(d.get('message') ?? '').trim();
    const note = document.querySelector<HTMLElement>('[data-contact-note]');
    if (note) {
      note.textContent = 'Opening your mail app…';
      note.style.color = 'var(--color-accent)';
    }
    const to = form.action.replace(/^mailto:/, '');
    const subject = encodeURIComponent(`Portfolio — ${name || 'hello'}`);
    const body = encodeURIComponent(`${msg}\n\n— ${name} (${email})`);
    window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
  });
</script>
