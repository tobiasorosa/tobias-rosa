---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import Experience from '../components/sections/Experience.astro';
import Toolkit from '../components/sections/Toolkit.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Work />
    <Experience />
    <Toolkit />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  /**
   * Progressive enhancement only: the page is complete without it.
   * The hero entrance is CSS; this covers the nav's active link and
   * the contact form.
   */

  // Nav scroll-spy.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter((s): s is Element => Boolean(s));

  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const a of links) {
            const active = a.getAttribute('href') === `#${e.target.id}`;
            if (active) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }

  // Contact form: compose a readable mailto: instead of the raw
  // enctype="text/plain" body the native form action would send.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const name = String(d.get('name') ?? '').trim();
    const email = String(d.get('email') ?? '').trim();
    const msg = String(d.get('message') ?? '').trim();
    const note = document.querySelector<HTMLElement>('[data-contact-note]');
    if (note) note.textContent = 'Opening your mail app…';
    const to = form.action.replace(/^mailto:/, '');
    const subject = encodeURIComponent(`Portfolio — ${name || 'hello'}`);
    const body = encodeURIComponent(`${msg}\n\n— ${name} (${email})`);
    window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
  });
</script>
