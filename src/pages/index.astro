---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import Experience from '../components/sections/Experience.astro';
import Toolkit from '../components/sections/Toolkit.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Work />
    <Experience />
    <Toolkit />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  /**
   * Progressive enhancement only: the page is complete without it.
   * The hero entrance is CSS; this covers the nav's active link and
   * the contact form.
   */

  // Nav scroll-spy. The active section is the last one whose top has gone
  // under the sticky nav. At the end of the page it is the last section,
  // which on a tall viewport never gets that far up.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter((s): s is Element => Boolean(s));
  const nav = document.querySelector('nav');

  if (sections.length && nav) {
    const mark = (id?: string) => {
      for (const a of links) {
        if (a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };

    const spy = () => {
      const line = nav.getBoundingClientRect().bottom;
      const atEnd =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 1;
      const current = atEnd
        ? sections.at(-1)
        : sections.findLast((s) => s.getBoundingClientRect().top <= line);
      mark(current?.id);
    };

    // A clicked link stays active while the scroll it started is running,
    // even if the page runs out before its section reaches the nav.
    let held = 0;
    const hold = () => {
      clearTimeout(held);
      held = window.setTimeout(() => (held = 0), 150);
    };
    for (const a of links) {
      a.addEventListener('click', () => {
        mark(a.hash.slice(1));
        hold();
      });
    }

    let queued = false;
    addEventListener(
      'scroll',
      () => {
        if (held) return hold();
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (!held) spy();
        });
      },
      { passive: true },
    );
    spy();
  }

  // Contact form: submit with fetch and report in the note, instead of the
  // native post's redirect to /sent. On any failure, point at the address.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const note = document.querySelector<HTMLElement>('[data-contact-note]');
  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const say = (text: string) => note && (note.textContent = text);
    if (button) button.disabled = true;
    form.setAttribute('aria-busy', 'true');
    say('Sending…');
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      say("Sent. I'll reply within a couple of days.");
    } catch {
      say(`Couldn't send. Email me at ${note?.dataset.email} instead.`);
    } finally {
      if (button) button.disabled = false;
      form.removeAttribute('aria-busy');
    }
  });
</script>
